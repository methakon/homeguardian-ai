# Copy to deploy/docker/.env (gitignored) and edit. `docker compose -f deploy/docker/docker-compose.yml`
# reads this file automatically from the compose file's own directory, from any working directory.
#
# HG_CERTS_DIR is REQUIRED and has no default: compose refuses to start an ingress without it rather
# than mounting an empty directory, which reads as a certificate failure instead of an unprovisioned
# deployment. It must contain ingress.json, server.crt, server.key, ca/ca.crt and devices.json, and
# its files must be READABLE by the container's uid (10001) - see docs/DISTRIBUTED_DEPLOYMENT.md.
HG_CERTS_DIR=/absolute/path/to/provisioned-certs

# Optional overrides.
# HG_INGRESS_BIND=0.0.0.0        # publish address for 8443 (loopback-only is the stricter choice)
# HG_INGRESS_PORT=8443
# HG_TAG=local                   # image tag
# HG_INGRESS_HEALTH_HOST=localhost   # the name the server certificate's SAN must carry
