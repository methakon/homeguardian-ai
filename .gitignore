# D-03 certificate material and device registry: NEVER committed.
# tools/provision_ca.sh writes these under an operator-chosen directory; the
# container looks them up in deploy/docker/certs/.
deploy/docker/certs/

# The compose project's own environment file: it carries HOST-SPECIFIC paths (at minimum
# HG_CERTS_DIR). Commit the example, never the file.
deploy/docker/.env
**/*.key
**/*.crt
**/*.csr
**/ca.srl
devices.json
revocations.json
hg_d03_*
